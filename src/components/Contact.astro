---
import { defineSchema, repeat, text, type InferProps } from 'nautcms'
import Lines from 'nautcms/content/Lines.astro'

export const schema = defineSchema({
  fits: ['page.body'],
  fields: {
    heading: text(),
    address: text({ multiline: true, lines: 'kept' }),
    phone: text(),
    email: text(),
    days: repeat({ days: text(), hours: text() }),
  },
})

type Props = InferProps<typeof schema>

const { heading, address, phone, email, days = [] } = Astro.props
---

<section class="wrap">
  <div class="card">
    <div>
      <h2 class="heading">{heading}</h2>
      <address><Lines value={address} /></address>
      <div class="lines">
        {phone && <a href={`tel:${phone.replaceAll(' ', '')}`}>{phone}</a>}
        {email && <a href={`mailto:${email}`}>{email}</a>}
      </div>
    </div>
    <dl>
      {
        days.map((d) => (
          <div>
            <dt>{d.days}</dt>
            <dd>{d.hours}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  section { padding-top: 64px; padding-bottom: 56px; }
  .card { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); gap: 56px; padding: 44px 48px 46px; border-radius: 4px; background: var(--color-lemon-sugar); }
  h2 { margin-bottom: 18px; }
  address { font-style: normal; font-family: var(--font-serif); font-size: 20px; line-height: 1.35; }
  .lines { display: grid; justify-items: start; gap: 4px; margin-top: 18px; font-size: 14px; }
  .lines a { border-bottom: 1px solid rgb(74 68 112 / 0.25); }

  /* Opening hours, set like an ingredient list with dotted leaders. */
  dl { align-self: end; display: grid; gap: 12px; margin: 0; }
  dl div { display: flex; align-items: baseline; gap: 10px; font-size: 14px; }
  dt { font-family: var(--font-serif); font-size: 20px; }
  dd { margin: 0; white-space: nowrap; }
  dl div::after { content: ''; order: 1; flex: 1; border-bottom: 1px dotted rgb(74 68 112 / 0.4); transform: translateY(-4px); }
  dd { order: 2; }

  @media (max-width: 640px) {
    .card { grid-template-columns: 1fr; gap: 30px; padding: 32px 26px; }
  }
</style>
